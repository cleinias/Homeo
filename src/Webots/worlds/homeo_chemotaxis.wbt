#VRML_SIM R2025a utf8
# Homeo's chemotaxis world, the Webots twin of KheperaSimulation's
# kheperaChemotaxis_HOMEO_World: the Braitenberg 2 world's open plane and
# robot (at (4, 4) facing +x), with a food source FOOD at (7, 7) where that
# world has its light, and no light.  Lengths in metres, z up.
# - FOOD is a marker: its chemical field has no Webots physics.  Homeo
#   computes it, and the robot's chemical eyes, from the poses Webots
#   records, with the Box2D formula (WebotsSimulation's virtual sensors).
#   It sits at the height of the e-puck's light sensors (32.9 mm).
# - The robot, HomeoEpuck (version 2), is Homeo's extern controller and a
#   supervisor: Homeo steps the world once per homeostat tick and reads the
#   poses it records (Webots/README, WebotsSimulator.WebotsSimulation).
# - Reproducibility: a fixed randomSeed and one physics thread.

EXTERNPROTO "../protos/HomeoEpuck.proto"

WorldInfo {
  info [
    "Homeo: chemotaxis world (twin of kheperaChemotaxis_HOMEO_World)"
  ]
  title "Homeo chemotaxis"
  basicTimeStep 32
  randomSeed 1
  optimalThreadCount 1
}
Viewpoint {
  orientation -0.4 0.4 0.8 1.75
  position 5.5 2.0 6.0
}
Background {
  skyColor [
    0.4 0.7 1
  ]
  luminosity 1
}
DEF FLOOR Solid {
  translation 7 7 0
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.8 0.5 0.3
        roughness 1
        metalness 0
      }
      geometry Plane {
        size 100 100
      }
    }
  ]
  name "floor"
  boundingObject Plane {
    size 100 100
  }
  locked TRUE
}
DEF FOOD Pose {
  translation 7 7 0.0329
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.8 0.2
        emissiveColor 0 0 0
        metalness 0
      }
      geometry Sphere {
        radius 0.06
      }
    }
  ]
}
DEF ROBOT HomeoEpuck {
  translation 4 4 0
  rotation 0 0 1 0
  name "e-puck"
  controller "<extern>"
  supervisor TRUE
  version "2"
  window "<none>"
}

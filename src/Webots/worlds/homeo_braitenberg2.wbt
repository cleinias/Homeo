#VRML_SIM R2025a utf8
# Homeo's Braitenberg 2 world, the Webots twin of KheperaSimulation's
# kheperaBraitenberg2_HOMEO_World: an open plane, the robot at (4, 4) facing
# +x, the light TARGET at (7, 7).  Lengths in metres, z up.
# - The light is a PointLight of intensity 100 with purely quadratic
#   attenuation and no ambient part, white: Webots' LightSensor then reads
#   exactly the Box2D eye's irradiance, att * I * cos (WbLightSensor.cpp:
#   the colour-filtered sum over R, G, B, divided by 3).  It sits at the
#   height of the e-puck's light sensors (32.9 mm), so distances are planar.
#   No other light: a DirectionalLight would reach every LightSensor.
# - The robot, HomeoEpuck (version 2), is Homeo's extern controller and a
#   supervisor: Homeo steps the world once per homeostat tick and reads the
#   poses it records (Webots/README, WebotsSimulator.WebotsSimulation).
# - Reproducibility: a fixed randomSeed and one physics thread.

EXTERNPROTO "../protos/HomeoEpuck.proto"

WorldInfo {
  info [
    "Homeo: Braitenberg 2 world (twin of kheperaBraitenberg2_HOMEO_World)"
  ]
  title "Homeo Braitenberg 2"
  basicTimeStep 32
  randomSeed 1
  optimalThreadCount 1
}
Viewpoint {
  orientation -0.4 0.4 0.8 1.75
  position 5.5 2.0 6.0
}
Background {
  skyColor [
    0.4 0.7 1
  ]
  luminosity 1
}
DEF FLOOR Solid {
  translation 7 7 0
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.8 0.5 0.3
        roughness 1
        metalness 0
      }
      geometry Plane {
        size 100 100
      }
    }
  ]
  name "floor"
  boundingObject Plane {
    size 100 100
  }
  locked TRUE
}
DEF TARGET PointLight {
  attenuation 0 0 1
  color 1 1 1
  intensity 100
  location 7 7 0.0329
  ambientIntensity 0
  castShadows FALSE
}
DEF TARGET_MARKER Pose {
  translation 7 7 0.0329
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1 1 0
        emissiveColor 1 1 0
        metalness 0
      }
      geometry Sphere {
        radius 0.06
      }
    }
  ]
}
DEF ROBOT HomeoEpuck {
  translation 4 4 0
  rotation 0 0 1 0
  name "e-puck"
  controller "<extern>"
  supervisor TRUE
  version "2"
  window "<none>"
}
